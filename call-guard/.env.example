# Copy this file to .env and fill in your keys. Never commit .env.

# Sarvam AI speech-to-text (https://dashboard.sarvam.ai)
SARVAM_API_KEY=
# saaras:v3 is Sarvam's current model; set saarika:v2.5 if your account uses that.
SARVAM_MODEL=saaras:v3
# transcribe = original language, translate = English, codemix = Hinglish (saaras only)
SARVAM_MODE=transcribe
# unknown = auto-detect. Or force one: hi-IN, en-IN, ta-IN, te-IN, bn-IN, mr-IN, gu-IN, kn-IN, ml-IN, pa-IN, od-IN
SARVAM_LANGUAGE=unknown

# OpenAI for the second-opinion scam check
OPENAI_API_KEY=
# Any chat model that supports JSON output. Use a small, fast one for live calls.
OPENAI_MODEL=gpt-4.1-mini

# Server
PORT=3000
# 127.0.0.1 = this computer only. Use 0.0.0.0 to reach it from your phone (needs https, see README).
HOST=127.0.0.1
